{
  "name": "defender-agent",
  "version": "2.0.0",
  "description": "Agente de administración remota - DEFENDERgroup",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "build": "npx pkg agent.js --targets node18-win-x64 --output defender-agent.exe --compress GZip"
  },
  "bin": "agent.js",
  "pkg": {
    "assets": [
      "config.json",
      "grab.ps1"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "node-screenshots": "^0.2.8",
    "socket.io-client": "^4.7.5",
    "sql.js": "^1.14.2"
  }
}
